local function CreateGloveModel()
    if workspace:FindFirstChild("nameModel") then
        workspace:FindFirstChild("nameModel"):Destroy()
    end
    local model = Instance.new("Model", workspace)
    model.Name = "nameModel"

    local glove = workspace.Lobby.Extended:Clone()
    local stand = workspace.Lobby.GloveStands.Extended:Clone()

    glove.Parent = model 
    stand.Parent = model

    if glove:FindFirstChildOfClass("ClickDetector") then
        glove:FindFirstChildOfClass("ClickDetector"):Destroy()
    end

    model:PivotTo(CFrame.new(-1219, 328, -2) * CFrame.Angles(math.rad(180), math.rad(90), 0))
    -- ^ you can edit It's position 
    return model, glove, stand
end

local function Customize(Model, Glove, Stand)
    Glove.Material = "Glass" -- this is optional
    Glove.Color = Color3.new(211,211,211) -- this is optional
    Glove.Name = "Killerfish" -- you can edit It's name
        
    Stand.Name = "Stand"

    local Desc = Stand:WaitForChild("GloveDesc")
    local Out = Desc:WaitForChild("DescOutline")
    local Frame = Out:WaitForChild("DescFrame")
    
    local Power = Frame:WaitForChild("Power")
    local Speed = Frame:WaitForChild("Speed")
    local Name = Frame:WaitForChild("Name")
    local Ability = Frame:WaitForChild("Ability")
    local AbilityType = Frame:WaitForChild("AbilityType")
    local Image = Frame:WaitForChild("ImageLabel")

    Out.BackgroundColor3 = Color3.new(1,1,1)

    Power.Text = "Power: 39"
    Speed.Text = "Speed: 16"
    Name.Text = "Glove"

    Ability.RichText = true
    Ability.Text = "Ability: vuela como pescado"

    AbilityType.Text = "Press E To Use"
  
    -- ^ you can edit those

    for i,v in next, Frame:GetChildren() do
        if v:IsA("TextLabel") then
            v.Font = "Code" -- you can edit the font or just delete this line
            local gra = Instance.new("UIGradient", v)
            gra.Rotation = 90
            gra.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
                ColorSequenceKeypoint.new(1, Color3.new(.5,.5,.5))
            })
        end
    end

    Image.Image = "rbxassetid://76111026492001" -- optional if you want an image 

    local Slaps = Stand:WaitForChild("SlapsInfoPart"):WaitForChild("SurfaceGui")    
    local amount = Slaps:WaitForChild("TextLabel")    
    amount.Text = "35 Slaps"
    amount.RichText = true
    amount.Font = "Fantasy" -- you can edit this
   
    local h = Instance.new("Highlight", Glove)
    h.FillTransparency = 1
    h.DepthMode = "Occluded"
  
  -- you can delete this highlight if you want your glove stand to not have an awesome highlight 
end

local function ClickDetection(Glove)
    local equip = game:GetService("ReplicatedStorage").GloveEquipParticle.Attachment
    local fail = game:GetService("ReplicatedStorage").GloveEquipParticle.Attachment2

    local click = Instance.new("ClickDetector", Glove)
    
    local g = leaderstats:WaitForChild("Glove")
    local unlocked = plr:WaitForChild("_unlockedGloves"):WaitForChild("Untitled Tag Glove").Value -- change this to the glove you're gonna use

    click.MouseClick:Connect(function()
        if unlocked then           
           fireclickdetector(workspace.Lobby["Untitled Tag Glove"].ClickDetector) -- change the name to the glove you're using to make the script work.
           
           task.spawn(function()
              task.wait(.8)
              g.Value = "Killerfish" -- your glove name here
           end)

           local s = equip:Clone()
           s.Parent = Glove
           for i,v in next, s:GetDescendants() do v:Emit(5) end 
           task.delay(1, function()
              if s then s:Destroy() end
           end)
        else
           workspace.Sounds.Fail:Play()
           local f = fail:Clone()
           f.Parent = Glove
           for i,v in next, f:GetDescendants() do v:Emit(5) end 
           task.delay(1, function()
              if f then f:Destroy() end
           end)
        end
    end)
end

