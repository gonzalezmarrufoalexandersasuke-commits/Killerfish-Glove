-- [[ Script Definitivo: Guante Depth (Base Iceskate + Modelo Replica Visual + Hyper Dash) ]] --

local plr = game:GetService("Players").LocalPlayer
local leaderstats = plr:WaitForChild("leaderstats", 5)

-- 1. CREACIÓN DEL MODELO CON ROTACIÓN FRONTAL PERFECTA
local function CreateGloveModel()
    if workspace:FindFirstChild("nameModel") then
        workspace:FindFirstChild("nameModel"):Destroy()
    end
    local model = Instance.new("Model", workspace)
    model.Name = "nameModel"

    local lobby = workspace:WaitForChild("Lobby", 10)
    if not lobby then return end

    -- Conseguimos el modelo de Replica para el pedestal (porque es azul y te gustó más)
    local gloveOriginal = lobby:WaitForChild("Replica", 10)
    local standsFolder = lobby:WaitForChild("GloveStands", 10)
    local standOriginal = standsFolder:WaitForChild("Extended", 10)

    if not gloveOriginal or not standOriginal then return end

    local glove = gloveOriginal:Clone()
    local stand = standOriginal:Clone()

    glove.Parent = model 
    stand.Parent = model

    if glove:FindFirstChildOfClass("ClickDetector") then
        glove:FindFirstChildOfClass("ClickDetector"):Destroy()
    end

    -- ROTACIÓN FRONTAL CORREGIDA: Queda recto mirando hacia ti sin tapar el cartel
    local char = plr.Character or plr.CharacterAdded:Wait()
    model:PivotTo(char.HumanoidRootPart.CFrame * CFrame.new(0, -1, -8) * CFrame.Angles(math.rad(90), math.rad(0), math.rad(180)))

    return model, glove, stand
end

-- 2. PERSONALIZACIÓN DEL PEDESTAL (89 SLAPS)
local function Customize(Model, Glove, Stand)
    Glove.Material = "Neon"
    Glove.Color = Color3.fromRGB(0, 180, 255) -- Azul cyan potente
    Glove.Name = "Glove"
    Stand.Name = "Stand"

    local Desc = Stand:WaitForChild("GloveDesc", 5)
    local Out = Desc:WaitForChild("DescOutline", 5)
    local Frame = Out:WaitForChild("DescFrame", 5)
    
    local Power = Frame:WaitForChild("Power", 5)
    local Speed = Frame:WaitForChild("Speed", 5)
    local Name = Frame:WaitForChild("Name", 5)
    local Ability = Frame:WaitForChild("Ability", 5)
    local AbilityType = Frame:WaitForChild("AbilityType", 5)
    local Image = Frame:WaitForChild("ImageLabel", 5)

    Out.BackgroundColor3 = Color3.new(1,1,1)

    Power.Text = "Power: 65"
    Speed.Text = "Speed: 25"
    Name.Text = "Depth"
    Ability.RichText = true
    Ability.Text = "Ability: Hyper Ice Dash"
    AbilityType.Text = "Press E To Skate"

    for i,v in next, Frame:GetChildren() do
        if v:IsA("TextLabel") then
            v.Font = "Code"
            local gra = Instance.new("UIGradient", v)
            gra.Rotation = 90
            gra.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
                ColorSequenceKeypoint.new(1, Color3.new(.5,.5,.5))
            })
        end
    end

    Image.Image = "rbxassetid://14950772479"

    local Slaps = Stand:WaitForChild("SlapsInfoPart", 5):WaitForChild("SurfaceGui", 5)    
    local amount = Slaps:WaitForChild("TextLabel", 5)    
    amount.Text = "89 Slaps"
    amount.RichText = true
    amount.Font = "Code"
   
    local h = Instance.new("Highlight", Glove)
    h.FillTransparency = 0.5
    h.DepthMode = "Occluded"

    local p = Instance.new("ParticleEmitter", Glove)
    p.Texture = "rbxassetid://241594247"
    p.Color = ColorSequence.new(Color3.fromRGB(0, 210, 255))
    p.Rate = 15
    p.Speed = NumberRange.new(2, 5)
    p.Size = NumberSequence.new(0.5, 0)
end

-- 3. TRANSFORMA EL GUANTE DE TU MANO EN AZUL NEÓN CON PARTICULAS
local function ApplyCustomGloveVisuals()
    local char = plr.Character
    if char then
        local realGlove = char:WaitForChild("Glove", 5)
        if realGlove and realGlove:IsA("BasePart") then
            realGlove.Color = Color3.fromRGB(0, 180, 255)
            realGlove.Material = "Neon"
            
            if not realGlove:FindFirstChild("DepthParticles") then
                local ep = Instance.new("ParticleEmitter", realGlove)
                ep.Name = "DepthParticles"
                ep.Texture = "rbxassetid://241594247"
                ep.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255))
                ep.Rate = 25
                ep.Size = NumberSequence.new(0.4, 0)
            end
        end
    end
end

-- 4. INTERACCIÓN DE CLIC: EQUIPA TU ICESKATE REAL Y LE PONE LA SKIN AZUL
local function ClickDetection(Glove)
    local repStorage = game:GetService("ReplicatedStorage")
    local equipPart = repStorage:WaitForChild("GloveEquipParticle", 5)
    local equip = equipPart:WaitForChild("Attachment", 5)

    local click = Instance.new("ClickDetector", Glove)
    local g = leaderstats:WaitForChild("Glove", 5)
    
    -- Como sí tienes Iceskate, verificamos su valor directamente sin bloqueos
    local unlocked = plr:WaitForChild("_unlockedGloves", 5):WaitForChild("Iceskate", 5).Value

    click.MouseClick:Connect(function()
        if unlocked then           
           -- Te equipa el guante real Iceskate de forma invisible
           if workspace.Lobby:FindFirstChild("Iceskate") then
               fireclickdetector(workspace.Lobby.Iceskate.ClickDetector)
           end
           
           task.spawn(function()
              task.wait(.4)
              if g then g.Value = "Depth" end -- Tu marcador dirá Depth
              ApplyCustomGloveVisuals() -- Convierte tu mano en Azul Neón
           end)

           local s = equip:Clone()
           s.Parent = Glove
           for i,v in next, s:GetDescendants() do if v:IsA("ParticleEmitter") then v:Emit(5) end end 
           task.delay(1, function() if s then s:Destroy() end end)
        end
    end)
end

-- 5. MEJORA DE HABILIDAD PARA LA TECLA E (MÚSICA + HIPER VELOCIDAD + LUZ AZUL)
local UserInputService = game:GetService("UserInputService")

UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if gameProcessedEvent then return end
    
    if input.KeyCode == Enum.KeyCode.E then
        local g = leaderstats:WaitForChild("Glove", 5)
        local char = plr.Character
        
        -- Se activa únicamente si llevas puesto tu guante Depth
        if g and g.Value == "Depth" and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            local root = char.HumanoidRootPart
            local hum = char.Humanoid
            
            -- [PASO 1] Encendemos el audio personalizado en Loop con tu ID
            local sound = Instance.new("Sound", root)
            sound.SoundId = "rbxassetid://72677561439951"
            sound.Volume = 2.5
            sound.Looped = true
            sound:Play()
            
            -- [PASO 2] Creamos la luz azul que expulsa el jugador
            local light = Instance.new("PointLight", root)
            light.Color = Color3.fromRGB(0, 180, 255)
            light.Range = 30
            light.Brightness = 6
            
            -- Partículas extras durante el avance veloz
            local trailParticles = Instance.new("ParticleEmitter", root)
            trailParticles.Texture = "rbxassetid://241594247"
            trailParticles.Color = ColorSequence.new(Color3.fromRGB(0, 255, 255))
            trailParticles.Rate = 70
            trailParticles.Speed = NumberRange.new(5)
            trailParticles.Size = NumberSequence.new(0.6, 0)

            -- [PASO 3] Lanzamos la habilidad real al servidor para que el juego sepa que patinas
            task.spawn(function()
                local remote = game:GetService("ReplicatedStorage"):WaitForChild("IceskateAbility", 2) or game:GetService("ReplicatedStorage"):WaitForChild("GloveAbility", 2)
                if remote then
                    remote:FireServer(true)
                end
            end)

            -- [PASO 4] SUPER DESLIZAMIENTO EXTRA: Añadimos un empuje físico de velocidad 95 hacia enfrente
            local attachment = Instance.new("Attachment", root)
            local linearVelocity = Instance.new("LinearVelocity", root)
            linearVelocity.Attachment0 = attachment
            linearVelocity.VectorVelocity = root.CFrame.LookVector * 95 
            linearVelocity.MaxForce = 999999
            
            hum.PlatformStand = true -- Posición de deslizamiento/agachado
            
            -- [PASO 5] Tiempo de duración (3 segundos de música, luz y velocidad)
            task.wait(3.0)
            
            -- [PASO 6] LIMPIEZA TOTAL: Eliminamos música, luz y efectos al terminar
            linearVelocity:Destroy()
            attachment:Destroy()
            trailParticles:Destroy()
            light:Destroy()
            
            sound:Stop()
            sound:Destroy()
            
            hum.PlatformStand = false -- El personaje se para con normalidad
            
            -- Reaseguramos que tu guante mantenga el nombre e identidad azul neón
            g.Value = "Depth"
            ApplyCustomGloveVisuals()
        end
    end
end)

-- Re-aplicar la textura azul neón si te eliminan en combate y vuelves a aparecer
plr.CharacterConnection = plr.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    local g = leaderstats:WaitForChild("Glove", 5)
    if g and g.Value == "Depth" then
        ApplyCustomGloveVisuals()
    end
end)

-- ==========================================
--  DISPARADOR PRINCIPAL DEL SCRIPT
-- ==========================================
local m, g, s = CreateGloveModel()
if m and g and s then
    Customize(m, g, s)
    ClickDetection(g)
end
